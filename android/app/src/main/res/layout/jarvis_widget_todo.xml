<?xml version="1.0" encoding="utf-8"?>
<!-- 할 일 5×2 (step 23): 다섯 줄 = D-n · (시각) 제목. 줄 수는 서버가 정한다(cal.widget limit) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jarvis_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jarvis_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/jarvis_todo_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/jarvis_todo_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_todo_label0"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFC857"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_todo_text0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/jarvis_todo_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_todo_label1"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFC857"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_todo_text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/jarvis_todo_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_todo_label2"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFC857"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_todo_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/jarvis_todo_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_todo_label3"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFC857"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_todo_text3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/jarvis_todo_row4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/jarvis_todo_label4"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:textColor="#FFFFC857"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jarvis_todo_text4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
